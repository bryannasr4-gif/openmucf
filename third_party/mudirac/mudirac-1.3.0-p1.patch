+/**
+ * Numerics options of the MuDirac 1.3.0 patch. Each default keeps MuDirac 1.3.0's arithmetic.
+ *
+ *   uehling_stable: TRUE          the uniform-sphere Uehling kernel in a cancellation-free form (trapezoid in u)
+ *   uehling_gauss: TRUE           the same kernel by Gauss-Legendre quadrature in theta (u = sin theta), uehling_steps nodes
+ *   fermi2_csteps: <n>            size of the hidden logarithmic grid of the 2pF Coulomb potential (MuDirac: 5000)
+ *   fermi2_hermite: TRUE          2pF Coulomb moments by 4-point Gauss-Legendre per interval, cubic Hermite read-back
+ *   state_header_precision: <n>   significant digits of the energy header of every state file (-1: the stream default)
+ *   domain_in_eps, domain_out_eps the tolerances MuDirac 1.3.0 hard-codes for the inner and outer integration domain
+ */
+#ifndef MUDIRAC_NUMERICS_HPP
+#define MUDIRAC_NUMERICS_HPP
+struct NumericsOptions {
+  bool uehling_stable = false;
+  bool uehling_gauss = false;
+  int fermi2_csteps = 5000;
+  bool fermi2_hermite = false;
+  int state_header_precision = -1;
+};
+extern NumericsOptions numerics_opt;
+#endif
