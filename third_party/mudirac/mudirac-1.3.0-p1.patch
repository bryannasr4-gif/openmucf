@@ -0,0 +1,39 @@
+/**
+ * Hamiltonian consistency options of the MuDirac 1.3.0 patch, and the exact 2pF helpers. Each default keeps
+ * MuDirac 1.3.0's arithmetic; the README lists the six inputs on which the default output was compared.
+ *
+ *   uehling_density: sphere|fermi2   V_U of the uniform sphere (MuDirac) or of the run's own 2pF charge density
+ *   uehling_shell_nodes: N_s         Gauss-Legendre nodes per s-panel of the 2pF Uehling superposition
+ *   fermi2_rms_exact: TRUE           the 2pF c solved from the exact 2pF moments for fermi2_rms_fm at the run's t
+ *   fermi2_rms_fm: <rms>             the run's intended rms charge radius (fm)
+ *   nuclear_mass: TRUE               mu from the nuclear mass M_atom amu - Z m_e + B_e(Z)/c^2
+ *   ev_codata2022: TRUE              Hartree -> eV with 27.211386245981 (CODATA 2022) on the output paths only
+ */
+#ifndef MUDIRAC_CONSISTENCY_HPP
+#define MUDIRAC_CONSISTENCY_HPP
+#include <string>
+
+struct ConsistencyOptions {
+  bool density_fermi2 = false;
+  int shell_nodes = 12;
+  bool rms_exact = false;
+  double rms_fm = -1;
+  bool nuclear_mass = false;
+  bool ev_codata2022 = false;
+};
+extern ConsistencyOptions consistency_opt;
+
+namespace Consistency {
+const double E_H_EV_2022 = 27.211386245981; // CODATA 2022 Hartree energy in eV
+// Output conversion factor (Hartree per eV): MuDirac's Physical::eV, or the CODATA 2022 value under the keyword
+double eV();
+// Exact rms radius of the 2pF density 1/(1 + exp(4 ln3 (r - c)/t)) by Gauss-Legendre moments (any length unit)
+double rms2pF(double c, double t);
+// The c >= 0 with rms2pF(c, t) = rms; inside = false (and -1 returned) when rms <= rms2pF(0, t)
+double cExact(double rms, double t, bool &inside);
+// Total electron binding energy B_e(Z) in Hartree (AME2020 II eq. 2, eV, converted with E_H_EV_2022)
+double electronBindingHa(int Z);
+// h(x) = (x - 1) + (x + 1) e^{-2x} = 2 e^{-x}(x cosh x - sinh x), series for x < 1
+double hOut(double x);
+} // namespace Consistency
+#endif
