 #include "potential.hpp"
+#include <algorithm>
+#include <cstring>
+
+// Gauss-Legendre nodes and weights on [-1, 1] by Newton iteration on P_n
+static void gaussLegendre(int n, double *x, double *w) {
+  int m = (n + 1) / 2;
+  for (int i = 1; i <= m; ++i) {
+    double z = cos(M_PI * (i - 0.25) / (n + 0.5));
+    double z1, pp;
+    int it = 0;
+    while (true) {
+      double p1 = 1.0, p2 = 0.0, p3;
+      for (int j = 1; j <= n; ++j) {
+        p3 = p2;
+        p2 = p1;
+        p1 = ((2.0 * j - 1.0) * z * p2 - (j - 1.0) * p3) / j;
+      }
+      pp = n * (z * p1 - p2) / (z * z - 1.0);
+      z1 = z;
+      z = z1 - p1 / pp;
+      ++it;
+      if (fabs(z - z1) <= 1e-15 || it >= 100)
+        break;
+    }
+    x[i - 1] = -z;
+    x[n - i] = z;
+    w[i - 1] = w[n - i] = 2.0 / ((1.0 - z * z) * pp * pp);
+  }
+}
+
+NumericsOptions numerics_opt;
+
+// ---------------------------------------------------------------------------------------------------------------
+// Hamiltonian consistency: options, exact 2pF helpers, the Uehling potential of the 2pF density
+// ---------------------------------------------------------------------------------------------------------------
+ConsistencyOptions consistency_opt;
+
+namespace Consistency {
+
+double eV() {
+  return consistency_opt.ev_codata2022 ? 1.0 / E_H_EV_2022 : Physical::eV;
+}
+
+// 2pF shape f(s) = 1/(1 + exp((s - c)/a)) without overflow
+static double fermiShape(double s, double c, double a) {
+  double x = (s - c) / a;
+  if (x > 0) {
+    double e = exp(-x);
+    return e / (1.0 + e);
+  }
+  return 1.0 / (1.0 + exp(x));
+}
+
+double rms2pF(double c, double t) {
+  double a = t / (4 * log(3.0));
+  double top = (c > 0 ? c : 0.0) + 60 * a;
+  int npan = (int)ceil(top / (0.5 * a));
+  double gx[16], gw[16];
+  gaussLegendre(16, gx, gw);
+  double i2 = 0, i4 = 0;
+  for (int p = 0; p < npan; ++p) {
+    double A = top * p / npan, B = top * (p + 1) / npan;
+    double mid = 0.5 * (A + B), half = 0.5 * (B - A);
+    for (int j = 0; j < 16; ++j) {
+      double s = mid + half * gx[j];
+      double f = fermiShape(s, c, a) * half * gw[j];
+      i2 += f * s * s;
+      i4 += f * s * s * s * s;
+    }
+  }
+  return sqrt(i4 / i2);
+}
+
+double cExact(double rms, double t, bool &inside) {
+  double floor0 = rms2pF(0.0, t);
+  if (!(rms > floor0)) {
+    inside = false;
+    return -1;
+  }
+  inside = true;
+  double lo = 0.0, hi = rms * sqrt(5.0 / 3.0) + t;
+  while (rms2pF(hi, t) < rms)
+    hi *= 2;
+  for (int it = 0; it < 400; ++it) {
+    double mid = 0.5 * (lo + hi);
+    if (mid <= lo || mid >= hi)
+      break;
+    if (rms2pF(mid, t) < rms)
+      lo = mid;
+    else
+      hi = mid;
+  }
+  return (fabs(rms2pF(lo, t) - rms) <= fabs(rms2pF(hi, t) - rms)) ? lo : hi;
+}
+
+double electronBindingHa(int Z) {
+  double z = Z;
+  return (14.4381 * pow(z, 2.39) + 1.55468e-6 * pow(z, 5.35)) / E_H_EV_2022;
+}
+
+double hOut(double x) {
+  if (x < 1.0) {
+    static const double cf[11] = {2.0 / 6.0, 4.0 / 120.0, 6.0 / 5040.0, 8.0 / 362880.0, 10.0 / 39916800.0,
+                                  12.0 / 6227020800.0, 14.0 / 1307674368000.0, 16.0 / 355687428096000.0,
+                                  18.0 / 121645100408832000.0, 20.0 / 51090942171709440000.0,
+                                  22.0 / 25852016738884976640000.0};
+    double x2 = x * x, p = x2 * x, acc = 0;
+    for (int m = 0; m < 11; ++m) {
+      acc += cf[m] * p;
+      p *= x2;
+    }
+    return 2 * exp(-x) * acc;
+  }
+  return (x - 1) + (x + 1) * exp(-2 * x);
+}
