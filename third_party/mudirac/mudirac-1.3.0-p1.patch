+} // namespace Consistency
+
+static inline uint64_t doubleBits(double r) {
+  uint64_t b;
+  memcpy(&b, &r, sizeof(b));
+  return b;
+}
+
+UehlingDensityPotential::UehlingDensityPotential(double Z, double c, double T, int usteps, int snodes, bool direct) {
+  this->Z = Z;
+  this->c = c;
+  this->T = T;
+  this->direct = direct;
+  nu = usteps;
+  ns = snodes;
+  if (nu < 1 || ns < 1 || T <= 0) {
+    throw invalid_argument("UehlingDensityPotential: invalid uehling_steps, uehling_shell_nodes or thickness");
+  }
+  a = T / (4 * log(3.0));
+  smin = (c - 40 * a > 0) ? c - 40 * a : 0.0;
+  smax = c + 40 * a;
+  npan = (int)ceil((smax - smin) / (2 * a));
+  if (npan < 1)
+    npan = 1;
+  edges = vector<double>(npan + 1);
+  for (int p = 0; p <= npan; ++p)
+    edges[p] = smin + (smax - smin) * p / npan;
+  edges[npan] = smax;
+  gx = vector<double>(ns);
+  gw = vector<double>(ns);
+  gaussLegendre(ns, gx.data(), gw.data());
+  // fixed nodes, panel-major
+  for (int p = 0; p < npan; ++p)
+    panelNodes(edges[p], edges[p + 1], fs, fq, fqn);
+  // base w-rule: nodes w_i = i h0, i = 0..nu (the w = 0 node carries zero weight: sinh^2 0 = 0)
+  const double k = 2 * Physical::c;
+  h0 = 18.0 / nu;
+  for (int i = 0; i <= nu; ++i) {
+    double w = i * h0;
+    double u = 1.0 / cosh(w);
+    double sh = sinh(w), ch = cosh(w);
+    double wt = (i == 0 ? 0.5 * h0 : h0) * (1 + 0.5 * u * u) * sh * sh / (ch * ch * ch);
+    bu.push_back(u);
+    bW.push_back(wt);
+    bku.push_back(k / u);
+    biu.push_back(u / k);
+  }
+  // per-panel sums of the panels above (w.r.t. B_p) and below (w.r.t. A_p): independent of r
+  int nb = nu + 1;
+  Tab = vector<double>((size_t)npan * nb, 0.0);
+  Tbe = vector<double>((size_t)npan * nb, 0.0);
+  QAab = vector<double>(npan, 0.0);
+  QNab = vector<double>(npan, 0.0);
+  QNbe = vector<double>(npan, 0.0);
+  for (int p = 0; p < npan; ++p) {
+    double A = edges[p], B = edges[p + 1];
+    for (int pp = 0; pp < npan; ++pp) {
+      if (pp == p)
+        continue;
+      for (int j = 0; j < ns; ++j) {
+        size_t idx = (size_t)pp * ns + j;
+        double s = fs[idx], q = fq[idx];
+        if (pp > p) {
+          QAab[p] += q;
+          QNab[p] += fqn[idx];
+          for (int i = 1; i < nb; ++i)
+            Tab[(size_t)p * nb + i] += q * exp(-bku[i] * (s - B)) * (s * biu[i] + biu[i] * biu[i]);
+        } else {
+          QNbe[p] += fqn[idx];
+          for (int i = 1; i < nb; ++i)
+            Tbe[(size_t)p * nb + i] += q * exp(-bku[i] * (A - s)) * Consistency::hOut(s * bku[i]);
+        }
+      }
+    }
+  }
+  built = true;
+}
+
+double UehlingDensityPotential::mfp(double s) const {
+  double e = exp(-fabs(s - c) / a);
+  return e / ((1 + e) * (1 + e)) / a;
+}
+
+void UehlingDensityPotential::panelNodes(double A, double B, vector<double> &s, vector<double> &q,
+                                         vector<double> &qn) const {
+  if (!(B > A))
+    return;
+  double mid = 0.5 * (A + B), half = 0.5 * (B - A);
+  for (int j = 0; j < ns; ++j) {
+    double sj = mid + half * gx[j];
+    double w = half * gw[j] * mfp(sj);
+    s.push_back(sj);
+    q.push_back(w);
+    qn.push_back(w * 4 * M_PI * sj * sj * sj / 3.0);
+  }
+}
+
+void UehlingDensityPotential::splitNodes(int p, double r, vector<double> &s, vector<double> &q,
+                                         vector<double> &qn) const {
+  double A = edges[p], B = edges[p + 1];
+  double d = r - A, e = B - r;
+  double sub[9] = {A, r - d / 4, r - d / 16, r - d / 64, r, r + e / 64, r + e / 16, r + e / 4, B};
+  for (int m = 0; m < 8; ++m)
+    panelNodes(sub[m], sub[m + 1], s, q, qn);
+}
+
+double UehlingDensityPotential::shapeCharge() {
+  double t = 0;
+  for (double x : fqn)
+    t += x;
+  return t;
+}
+
+double UehlingDensityPotential::farSum(double r, const vector<double> &s, const vector<double> &q) const {
+  // r at or beyond the s-range: every node has s < r; the w-step shrinks as h0/sqrt(1 + z), z = 2c (r - s_max)
+  const double k = 2 * Physical::c;
+  double z = k * (r - smax);
+  if (!(z > 0)) {
+    double S = 0;
+    for (int i = 1; i <= nu; ++i) {
+      double acc = 0;
+      for (size_t j = 0; j < s.size(); ++j)
+        acc += q[j] * exp(-bku[i] * (r - s[j])) * Consistency::hOut(s[j] * bku[i]);
+      S += bW[i] * biu[i] * biu[i] * acc;
+    }
+    return S;
+  }
+  double h = h0 / sqrt(1 + z);
+  double wmax = acosh(1 + 45.0 / z);
+  if (wmax > 18.0)
+    wmax = 18.0;
+  int n = (int)floor(wmax / h) + 1;
+  double S = 0;
+  for (int i = 1; i < n; ++i) {
+    double w = i * h;
+    double u = 1.0 / cosh(w);
+    double sh = sinh(w), ch = cosh(w);
+    double wt = h * (1 + 0.5 * u * u) * sh * sh / (ch * ch * ch);
+    double ku = k / u, iu = u / k;
+    double acc = 0;
+    for (size_t j = 0; j < s.size(); ++j)
+      acc += q[j] * exp(-ku * (r - s[j])) * Consistency::hOut(s[j] * ku);
+    S += wt * iu * iu * acc;
+  }
+  return S;
+}
+
+double UehlingDensityPotential::computeDirect(double r) {
+  // the plain double sum over the (split) node set and the w-rule: the reference for compute()
+  vector<double> s, q, qn;
+  if (r > smin && r < smax) {
+    int p = (int)(upper_bound(edges.begin(), edges.end(), r) - edges.begin()) - 1;
+    for (int pp = 0; pp < npan; ++pp) {
+      if (pp == p)
+        splitNodes(pp, r, s, q, qn);
+      else
+        panelNodes(edges[pp], edges[pp + 1], s, q, qn);
+    }
+  } else {
+    s = fs;
+    q = fq;
+    qn = fqn;
+  }
+  double Q = 0;
+  for (double x : qn)
+    Q += x;
+  double S = 0;
+  if (r >= smax) {
+    S = farSum(r, s, q);
+  } else {
+    for (int i = 1; i <= nu; ++i) {
+      double ku = bku[i], iu = biu[i];
+      double acc = 0;
+      for (size_t j = 0; j < s.size(); ++j) {
+        double y;
+        if (r <= s[j])
+          y = 2 * r * iu - exp(-ku * (s[j] - r)) * (-expm1(-2 * r * ku)) * (s[j] * iu + iu * iu);
+        else
+          y = iu * iu * exp(-ku * (r - s[j])) * Consistency::hOut(s[j] * ku);
+        acc += q[j] * y;
+      }
+      S += bW[i] * acc;
+    }
+  }
+  return -(2 * Physical::alpha / (3 * Physical::c * r)) * (Z / Q) * S;
+}
+
+double UehlingDensityPotential::compute(double r) {
+  if (direct || r <= smin || r >= smax)
+    return computeDirect(r);
+  // smin < r < smax: panel p holds r; the panels above and below by their precomputed sums, panel p split at r
+  int p = (int)(upper_bound(edges.begin(), edges.end(), r) - edges.begin()) - 1;
+  double A = edges[p], B = edges[p + 1];
+  vector<double> s, q, qn;
+  splitNodes(p, r, s, q, qn);
+  double Q = QNab[p] + QNbe[p];
+  for (double x : qn)
+    Q += x;
+  int nb = nu + 1;
+  double S = 0;
+  for (int i = 1; i < nb; ++i) {
+    double ku = bku[i], iu = biu[i];
+    double above = 2 * r * iu * QAab[p] - (-expm1(-2 * r * ku)) * exp(-ku * (B - r)) * Tab[(size_t)p * nb + i];
+    double below = iu * iu * exp(-ku * (r - A)) * Tbe[(size_t)p * nb + i];
+    double acc = 0;
+    for (size_t j = 0; j < s.size(); ++j) {
+      double y;
+      if (r <= s[j])
+        y = 2 * r * iu - exp(-ku * (s[j] - r)) * (-expm1(-2 * r * ku)) * (s[j] * iu + iu * iu);
+      else
+        y = iu * iu * exp(-ku * (r - s[j])) * Consistency::hOut(s[j] * ku);
+      acc += q[j] * y;
+    }
+    S += bW[i] * (above + below + acc);
+  }
+  return -(2 * Physical::alpha / (3 * Physical::c * r)) * (Z / Q) * S;
+}
+
+double UehlingDensityPotential::V(double r) {
+  if (r <= 0) {
+    throw invalid_argument("UehlingDensityPotential: r must be positive");
+  }
+  if (r > exp_cutoff_high * 0.5 * Physical::alpha) {
+    return 0.0;
+  }
+  uint64_t key = doubleBits(r);
+  auto it = memo.find(key);
+  if (it != memo.end())
+    return it->second;
+  double v = compute(r);
+  memo[key] = v;
+  return v;
+}
 
