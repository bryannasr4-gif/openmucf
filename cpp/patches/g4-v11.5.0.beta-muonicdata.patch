+G4double G4MuonicAtomHelper::GetKShellEnergy(G4double Z, G4int A)
+{
+  if (G4MuonicDataTable::IsEnabled()) {
+    const G4int iz = static_cast<G4int>(Z);
+    if (static_cast<G4double>(iz) == Z) {
+      if (const G4double* v = G4MuonicDataOverlay::KShell(iz, A)) return *v * keV;
+    }
+  }
+  return GetKShellEnergy(Z);
+}
