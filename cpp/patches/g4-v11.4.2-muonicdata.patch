+void G4HadronicParameters::SetEnableMuonicBoundRates( G4bool val ) {
+  if ( ! IsLocked() ) {
+    if ( val ) G4MuonicBoundRateProvider::Enable();
+    else G4MuonicBoundRateProvider::Disable();
+    fEnableMuonicBoundRates = G4MuonicBoundRateProvider::IsEnabled();
+  }
+}
