+void G4HadronicParameters::SetEnableMuonicData( G4bool val ) {
+  if ( ! IsLocked() ) {
+    fEnableMuonicData = val;
+    if ( val ) {
+      G4MuonicDataTable::Enable();
+      G4MuonicDataOverlay::Initialize();
+    }
+    else G4MuonicDataTable::Disable();
+  }
+}
