#
# degenerate        excluded from the sweep and from the digest: these return non-finite
#                   values, and a NaN has no single bit pattern to hash. Compared by
#                   CLASSIFICATION rather than by value. Registered as a finding, not fixed.
RATE 0 12 nan -nan
RATE 0 1 nan -nan
RATE 1 0 +inf inf
RATE -1 12 negative -0x1.3f4c31fa227f6p-21
